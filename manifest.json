{
  "manifest_version": 3,
  "name": "Queens Solver",
  "version": "1.0.0",
  "description": "Solves the LinkedIn Queens puzzle and overlays the solution on top of the page without touching the underlying DOM.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/games/queens/*"],
      "js": ["solver.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
