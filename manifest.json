{
  "manifest_version": 3,
  "name": "LockedIn",
  "version": "1.7.0",
  "description": "Solves LinkedIn's puzzle games (Queens, Tango, Mini Sudoku, Zip, Patches, Wend, CrossClimb) and overlays the solution on top of the page without touching the underlying DOM.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/games/*"],
      "js": [
        "shared/overlay.js",
        "games/queens/solver.js",
        "games/queens/game.js",
        "games/tango/solver.js",
        "games/tango/game.js",
        "games/sudoku/solver.js",
        "games/sudoku/game.js",
        "games/zip/solver.js",
        "games/zip/game.js",
        "games/patches/game.js",
        "games/wend/game.js",
        "games/crossclimb/game.js",
        "content.js"
      ],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
